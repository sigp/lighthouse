#!/bin/sh
# Compatibility entrypoint used by ethereum-package. Proving is inside Lighthouse.
set -eu
# Explicit CLI configuration wins over the historical wrapper environment variable.
for argument in "$@"; do
    case "$argument" in
        --pq-prover-threads|--pq-prover-threads=*) exec lighthouse beacon_node "$@" ;;
    esac
done
exec lighthouse beacon_node --pq-prover-threads "${LEANVM_THREADS:-0}" "$@"

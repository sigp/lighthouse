#!/bin/sh
set -eu

# Keep profile flags and priority in sync with pq-aggregation-bench's
# scripts/build-binaries.sh (profiles introduced at 181a202a4e44).
architecture=$1

build_sidecar() (
    profile=$1
    binary=$2
    flags=$3
    CARGO_TARGET_DIR="/leanvm/target/$profile" RUSTFLAGS="$flags" \
        cargo build --target "$target" --locked --release -p leanvm-sidecar --features experimental_prover
    install -D "/leanvm/target/$profile/$target/release/leanvm-sidecar" "$binary"
)

build_x86_profile() {
    profile=$1
    flags=$2
    binary="leanvm-sidecar-$profile"
    build_sidecar "$profile" "$variants/$binary" "$flags"

    required_flags=
    if [ "$profile" != generic ]; then
        # Cargo gives these flags only to the target, not the host build scripts or macros.
        # Require Rust's implicit features too, with their Linux /proc/cpuinfo names.
        # The flag words are the same fixed arguments passed to Cargo in build_sidecar.
        # shellcheck disable=SC2086
        cfg=$(rustc --target "$target" $flags --print cfg)
        required_flags=$(printf '%s\n' "$cfg" | awk -F'"' '
            /^target_feature=/ {
                feature = $2
                if (feature == "sse3") feature = "pni"
                if (feature == "sse4.1") feature = "sse4_1"
                if (feature == "sse4.2") feature = "sse4_2"
                printf "%s%s", separator, feature
                separator = " "
            }
        ')
        test -n "$required_flags"
    fi
    printf '%s\t%s\t%s\n' "$profile" "$binary" "$required_flags" >> "$variants/profiles.tsv"
}

case "$architecture" in
    arm64)
        target=aarch64-unknown-linux-gnu
        export JEMALLOC_SYS_WITH_LG_PAGE=16
        build_sidecar portable /out/bin/leanvm-sidecar "-C target-cpu=generic -C target-feature=+aes"
        ;;
    amd64)
        target=x86_64-unknown-linux-gnu
        variants=/out/lib/lighthouse/leanvm
        mkdir -p "$variants"
        : > "$variants/profiles.tsv"
        generic="-C target-cpu=x86-64"
        portable="$generic -C target-feature=+ssse3,+pclmulqdq"
        avx2="$portable,+avx2,+bmi2"
        avx2_gfni="$avx2,+gfni,+vpclmulqdq"
        avx512="$avx2_gfni,+avx512f,+avx512bw,+avx512vbmi"
        build_x86_profile generic "$generic"
        build_x86_profile portable "$portable"
        build_x86_profile avx2 "$avx2"
        build_x86_profile avx2-gfni "$avx2_gfni"
        build_x86_profile avx512 "$avx512"
        install -D /tmp/leanvm-sidecar-select /out/bin/leanvm-sidecar
        ;;
    *)
        echo "Unsupported leanVM target architecture: $architecture" >&2
        exit 1
        ;;
esac

mkdir -p /out/share/lighthouse
git rev-parse HEAD > /out/share/lighthouse/leanvm-revision

#!/usr/bin/python3
"""Exec the fastest sidecar profile supported by the Linux x86-64 host."""

import os
import sys


SIDECARS = "/usr/local/lib/lighthouse/leanvm"


def linux_cpu_flags(affinity, cpuinfo):
    # Same feature intersection as pq-aggregation-bench's linux_cpu_information
    # (181a202a4e44). linux flags also reflect kernel support for vector state.
    flags_by_cpu = {}
    for entry in cpuinfo.split("\n\n"):
        fields = {}
        for line in entry.splitlines():
            name, sep, value = line.partition(":")
            if sep:
                fields[name.strip()] = value.strip()
        cpu = fields.get("processor", "")
        if cpu.isdecimal() and (affinity is None or int(cpu) in affinity):
            flags_by_cpu[int(cpu)] = set(fields.get("flags", fields.get("Features", "")).split())

    enough_cpus = flags_by_cpu and (affinity is None or flags_by_cpu.keys() == affinity)
    return set.intersection(*flags_by_cpu.values()) if enough_cpus else set()


def select_sidecar(variants, requested, cpu_flags):
    # As in the benchmark, preference is highest supported first. A requested
    # profile is still subject to the CPU compatibility check.
    for profile, binary, required_flags in reversed(variants):
        if requested != "auto" and requested != profile:
            continue
        missing = required_flags - cpu_flags
        if not missing:
            return profile, binary
        if requested == profile:
            raise ValueError(f"CPU profile {profile} requires: {', '.join(sorted(missing))}")
    raise ValueError(f"no sidecar available for CPU profile {requested}")


def main():
    try:
        affinity = os.sched_getaffinity(0)
    except OSError:
        affinity = None
    try:
        with open("/proc/cpuinfo", encoding="utf-8", errors="replace") as info:
            cpu_flags = linux_cpu_flags(affinity, info.read().strip())
    except OSError:
        cpu_flags = set()

    try:
        with open(os.path.join(SIDECARS, "profiles.tsv"), encoding="utf-8") as manifest:
            variants = []
            for line in manifest:
                profile, binary, required_flags = line.rstrip("\n").split("\t")
                variants.append((profile, binary, set(required_flags.split())))
        requested = os.environ.get("LEANVM_CPU_PROFILE", "auto")
        profile, binary = select_sidecar(variants, requested, cpu_flags)
        print(f"leanvm-sidecar CPU profile: {profile}", file=sys.stderr, flush=True)
        os.execv(os.path.join(SIDECARS, binary), [binary, *sys.argv[1:]])
    except (OSError, ValueError) as error:
        print(f"leanvm-sidecar: {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()

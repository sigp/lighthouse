diff --git a/validators/vrf_test.go b/validators/vrf_test.go
index 7a62714..3e89565 100644
--- a/validators/vrf_test.go
+++ b/validators/vrf_test.go
@@ -3,0 +4,2 @@ import (
+	"crypto/sha256"
+	"encoding/hex"
@@ -45,0 +48,31 @@ func TestVRFProofs(t *testing.T) {
+
+func TestPaddedKeccakVRFVector(t *testing.T) {
+	signingKey, err := hex.DecodeString("2892f3ba475c3640a67fe730798ad9c4eed3a6d934db85f91c41cfc837ce8834")
+	if err != nil {
+		t.Fatal(err)
+	}
+	seed := VRFSeed(signingKey)
+	root := VRFRoot(seed)
+	if got := hex.EncodeToString(root[:]); got != "46f6772a35c14c7f8467e9d8791450ed3c6853191129876fc50e769ec9bac18d" {
+		t.Fatalf("padded Keccak VRF root: %s", got)
+	}
+	for _, vector := range []struct {
+		slot   uint64
+		digest string
+	}{
+		{0, "4107fa0f9dad85074520eb0cdcf35264504f076c0c50b8cf8103a509c372d86c"},
+		{5, "4e0efa764e7c54ddbfba1f1266497f55b82a4d363d30f77dfb520904f59aa8d5"},
+		{1<<vrfPopulatedDepth - 1, "4be4c0afca9d7139ed7a1e52a399bf4787478cd561bb32a0138a0550fd44d7d5"},
+		{1 << vrfPopulatedDepth, "3b7f91d3371503c6268e3fa967ca51cbe43b6803f7c9662d95734e1b1d36d381"},
+		{1<<VRFTreeDepth - 1, "a6e044ad1b73627b876ce31ecd9ee2c2093279ee56af9c67004f7a26cb49c5a4"},
+	} {
+		proof := VRFProof(seed, vector.slot)
+		digest := sha256.New()
+		for _, node := range proof {
+			digest.Write(node[:])
+		}
+		if got := hex.EncodeToString(digest.Sum(nil)); got != vector.digest {
+			t.Errorf("proof fingerprint at slot %d: %s, want %s", vector.slot, got, vector.digest)
+		}
+	}
+}

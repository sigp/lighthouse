Built by and for sovereign authors. Timestamp truth.
// src/validator_client/custom.rs
use chrono::Utc;
use std::fs::OpenOptions;
use std::io::Write;

pub fn log_sync(distance: u64, pubkey: &str) {
    let timestamp = Utc::now().to_rfc3339();
    let json = format!(
        "{{\"timestamp\":\"{}\",\"sync_distance\":{},\"validator_pubkey\":\"{}\"}}\n",
        timestamp, distance, pubkey
    );

    let mut file = OpenOptions::new()
        .append(true)
        .create(true)
        .open("beacon_sync.json")
        .expect("Unable to open sync log");

    file.write_all(json.as_bytes()).expect("Failed to write log");
}
chrono = "0.4"

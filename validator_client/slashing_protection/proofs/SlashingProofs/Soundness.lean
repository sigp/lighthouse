import SlashingProofs.Generated

/-!
# Soundness of Lighthouse's `check_attestation`

`Pure.lean` is generated by Aeneas from
`validator_client/slashing_protection/src/attestation_rules.rs` in the Lighthouse tree.
Nothing in it mentions slashing. This file says what it means, and proves that a
`Verdict.Valid` answer really does rule out both slashing conditions.
-/

namespace SlashingProofs

open Aeneas Aeneas.Std Aeneas.Std.WP Result slashing_protection

/-! ## Signing-root comparison

    `roots_eq` only ever distinguishes `SameData` from `DoubleVote`, and neither is `Valid`,
    so the soundness theorem does not depend on what it computes -- only on the fact that it
    terminates. Its actual behaviour (in particular that a null root never compares equal) is
    covered by `null_root_is_never_same_data` in `../src/exhaustive_tests.rs`. -/

@[step]
theorem roots_eq_loop_spec
    (a b : Array U8 32#usize) (nul eq : Bool) (i : Usize) (hi : i.val ≤ 32) :
    attestation_rules.roots_eq_loop a b nul eq i ⦃ _ => True ⦄ := by
  unfold attestation_rules.roots_eq_loop
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => 32 - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) => x.2.2.val ≤ 32)
  · rintro ⟨n1, e1, j⟩ hj
    dsimp only at hj
    unfold attestation_rules.roots_eq_loop.body
    dsimp only
    split
    · have hla : a.val.length = 32 := by simp
      have hlb : b.val.length = 32 := by simp
      have hlt : j.val < 32 := by scalar_tac
      have hja : j.val < a.val.length := by omega
      have hjb : j.val < b.val.length := by omega
      -- The body reads `a[j]`, branches, reads `b[j]`, branches, then increments.
      step as ⟨x, hx⟩
      repeat' split
      all_goals step as ⟨y, hy⟩
      repeat' split
      all_goals (
        step as ⟨j3, hj3⟩ <;>
          first
            | scalar_tac
            | exact ⟨by omega, by omega⟩)
    · simp only [spec_ok]
  · exact hi

@[step]
theorem roots_eq_spec (a b : Array U8 32#usize) :
    attestation_rules.roots_eq a b ⦃ _ => True ⦄ := by
  unfold attestation_rules.roots_eq
  step as ⟨nul, eq⟩
  split <;> simp

/-! ## The slashing conditions -/

def Surrounds (a b : attestation_rules.AttRow) : Prop :=
  a.source < b.source ∧ b.target < a.target

def DoubleVote (a b : attestation_rules.AttRow) : Prop :=
  a.target = b.target ∧ a.root.val ≠ b.root.val

def Slashable (a b : attestation_rules.AttRow) : Prop :=
  DoubleVote a b ∨ Surrounds a b ∨ Surrounds b a

/-! ## The three scanning loops -/

@[step]
theorem loop0_spec
    (history : Slice attestation_rules.AttRow) (t : U64) (r : Array U8 32#usize) (n : Usize)
    (hn : n.val = history.length) :
    attestation_rules.check_attestation_loop0 history t r n false false 0#usize ⦃ res =>
      res.1 = true ↔ ∃ b ∈ history.v, b.target = t ⦄ := by
  unfold attestation_rules.check_attestation_loop0
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => history.length - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (x.1 = true ↔ ∃ b ∈ history.v.take x.2.2.val, b.target = t))
  · rintro ⟨stf, sr, i⟩ ⟨hi, hstf⟩
    dsimp only at hi hstf
    unfold attestation_rules.check_attestation_loop0.body
    dsimp only
    split
    · have hlt : i.val < history.length := by scalar_tac
      step as ⟨ar, har⟩
      have htake : history.v.take (i.val + 1) = history.v.take i.val ++ [ar] := by
        rw [List.take_add_one, har]; simp [hlt]
      split
      · step as ⟨beq⟩
        split <;>
          (step as ⟨i3, hi3⟩ <;>
            first
              | scalar_tac
              | (refine ⟨by omega, ?_, by omega⟩ <;>
                  (rw [hi3, htake]
                   first
                     | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
      · step as ⟨i3, hi3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, by omega⟩ <;>
                (rw [hi3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind))
    · have hieq : i.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hieq] at hstf
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at hstf
      exact hstf
  · simp

@[step]
theorem loop1_spec
    (history : Slice attestation_rules.AttRow) (s t : U64) (n : Usize)
    (hn : n.val = history.length) :
    attestation_rules.check_attestation_loop1 history s t n false false 0#usize ⦃ res =>
      (res.1 = true ↔ ∃ b ∈ history.v, b.source < s ∧ t < b.target)
      ∧ (res.2 = true ↔ ∃ b ∈ history.v, s < b.source ∧ b.target < t) ⦄ := by
  unfold attestation_rules.check_attestation_loop1
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => history.length - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (x.1 = true ↔ ∃ b ∈ history.v.take x.2.2.val, b.source < s ∧ t < b.target)
      ∧ (x.2.1 = true ↔ ∃ b ∈ history.v.take x.2.2.val, s < b.source ∧ b.target < t))
  · rintro ⟨prev, new, i⟩ ⟨hi, hprev, hnew⟩
    dsimp only at hi hprev hnew
    unfold attestation_rules.check_attestation_loop1.body
    dsimp only
    split
    · have hlt : i.val < history.length := by scalar_tac
      step as ⟨ar, har⟩
      have htake : history.v.take (i.val + 1) = history.v.take i.val ++ [ar] := by
        rw [List.take_add_one, har]; simp [hlt]
      repeat' split
      all_goals (
        step as ⟨i3, hi3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, ?_, by omega⟩ <;>
                (rw [hi3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
    · have hieq : i.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hieq] at hprev hnew
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at hprev hnew
      exact ⟨hprev, hnew⟩
  · simp

@[step]
theorem loop2_spec
    (history : Slice attestation_rules.AttRow) (n : Usize) (ms mt : U64) (i : Usize)
    (hn : n.val = history.length) (hi : i.val ≤ history.length)
    (hms : ∀ b ∈ history.v.take i.val, ms ≤ b.source)
    (hms' : ∃ b ∈ history.v.take i.val, ms = b.source)
    (hmt : ∀ b ∈ history.v.take i.val, mt ≤ b.target)
    (hmt' : ∃ b ∈ history.v.take i.val, mt = b.target) :
    attestation_rules.check_attestation_loop2 history n ms mt i ⦃ res =>
      (∀ b ∈ history.v, res.1 ≤ b.source) ∧ (∃ b ∈ history.v, res.1 = b.source)
      ∧ (∀ b ∈ history.v, res.2 ≤ b.target) ∧ (∃ b ∈ history.v, res.2 = b.target) ⦄ := by
  unfold attestation_rules.check_attestation_loop2
  apply loop.spec_decr_nat
    (measure := fun (x : U64 × U64 × Usize) => history.length - x.2.2.val)
    (inv := fun (x : U64 × U64 × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (∀ b ∈ history.v.take x.2.2.val, x.1 ≤ b.source)
      ∧ (∃ b ∈ history.v.take x.2.2.val, x.1 = b.source)
      ∧ (∀ b ∈ history.v.take x.2.2.val, x.2.1 ≤ b.target)
      ∧ (∃ b ∈ history.v.take x.2.2.val, x.2.1 = b.target))
  · rintro ⟨ms1, mt1, j⟩ ⟨hj, h1, h2, h3, h4⟩
    dsimp only at hj h1 h2 h3 h4
    unfold attestation_rules.check_attestation_loop2.body
    dsimp only
    split
    · have hlt : j.val < history.length := by scalar_tac
      step as ⟨ar, har⟩
      have htake : history.v.take (j.val + 1) = history.v.take j.val ++ [ar] := by
        rw [List.take_add_one, har]; simp [hlt]
      repeat' split
      all_goals (
        step as ⟨j3, hj3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, ?_, ?_, ?_, by omega⟩ <;>
                (rw [hj3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
    · have hjeq : j.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hjeq] at h1 h2 h3 h4
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at h1 h2 h3 h4
      exact ⟨h1, h2, h3, h4⟩
  · exact ⟨hi, hms, hms', hmt, hmt'⟩

/-! ## Soundness of Lighthouse's `check_attestation` -/

theorem check_attestation_sound
    (history : Slice attestation_rules.AttRow) (candidate : attestation_rules.AttRow) :
    attestation_rules.check_attestation history candidate ⦃ res =>
      res = attestation_rules.Verdict.Valid → ∀ b ∈ history.v, ¬ Slashable candidate b ⦄ := by
  unfold attestation_rules.check_attestation
  split
  · simp
  · step as ⟨found, same, hfound⟩
    split
    · split <;> simp
    · step as ⟨prev, new, hprev, hnew⟩
      split
      · simp
      · split
        · simp
        · split
          · step as ⟨ar, har⟩
            have hpos : 0 < history.v.length := by
              have : 0 < history.length := by scalar_tac
              simpa [Slice.length] using this
            have htake1 : history.v.take 1 = [ar] := by
              simp [har, List.take_one, List.head?_eq_getElem?, hpos]
            step as ⟨mins, mint, hms1, hms2, hmt1, hmt2⟩
            case hms => simp [htake1]
            case hms' => simp [htake1]
            case hmt => simp [htake1]
            case hmt' => simp [htake1]
            split
            · simp
            · split
              · simp
              · intro _ b hb
                rintro (⟨ht, hr⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩)
                · exact absurd (hfound.mpr ⟨b, hb, ht.symm⟩) (by simp_all)
                · exact absurd (hnew.mpr ⟨b, hb, h1, h2⟩) (by simp_all)
                · exact absurd (hprev.mpr ⟨b, hb, h1, h2⟩) (by simp_all)
          · intro _ b hb
            have hlen : history.length = 0 := by scalar_tac
            have hnil : history.v = [] := by
              simpa [Slice.length, List.length_eq_zero_iff] using hlen
            simp [hnil] at hb

end SlashingProofs

import SlashingProofs.Generated
import SlashingProofs.Spec

/-!
# Soundness of Lighthouse's `check_attestation`

`Generated.lean` is generated by Aeneas from
`validator_client/slashing_protection/src/attestation_rules.rs` in the Lighthouse tree.
`Spec.lean` says what slashable means. This file proves that a `Verdict.Valid` answer really
does rule out both slashing conditions.
-/

namespace SlashingProofs

open Aeneas Aeneas.Std Aeneas.Std.WP Result slashing_protection

/-! ## Signing-root comparison

    `roots_eq` only ever distinguishes `SameData` from `DoubleVote`, and neither is `Valid`,
    so the soundness theorem does not depend on what it computes -- only on the fact that it
    does not fail. Its actual behaviour (in particular that a null root never compares equal) is
    covered by `null_root_is_never_same_data` in `../src/exhaustive_tests.rs`. -/

/-- The root comparison loop does not fail for any index up to 32. -/
@[step]
theorem roots_eq_loop_spec
    (stored_root candidate_root : Array U8 32#usize) (stored_root_is_null equal : Bool)
    (i : Usize) (hi : i.val ≤ 32) :
    attestation_rules.roots_eq_loop stored_root candidate_root stored_root_is_null equal i
      ⦃ _ => True ⦄ := by
  unfold attestation_rules.roots_eq_loop
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => 32 - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) => x.2.2.val ≤ 32)
  · rintro ⟨n1, e1, j⟩ hj
    dsimp only at hj
    unfold attestation_rules.roots_eq_loop.body
    dsimp only
    split
    · have hla : stored_root.val.length = 32 := by simp
      have hlb : candidate_root.val.length = 32 := by simp
      have hlt : j.val < 32 := by scalar_tac
      have hja : j.val < stored_root.val.length := by omega
      have hjb : j.val < candidate_root.val.length := by omega
      -- The body reads `stored_root[j]`, branches, reads `candidate_root[j]`, branches,
      -- then increments.
      step as ⟨x, hx⟩
      repeat' split
      all_goals step as ⟨y, hy⟩
      repeat' split
      all_goals (
        step as ⟨j3, hj3⟩ <;>
          first
            | scalar_tac
            | exact ⟨by omega, by omega⟩)
    · simp only [spec_ok]
  · exact hi

/-- `roots_eq` does not fail. -/
@[step]
theorem roots_eq_spec (stored_root candidate_root : Array U8 32#usize) :
    attestation_rules.roots_eq stored_root candidate_root ⦃ _ => True ⦄ := by
  unfold attestation_rules.roots_eq
  step as ⟨stored_root_is_null, equal⟩
  split <;> simp

/-! ## The three scanning loops -/

/-- `same_target_found` is true iff a stored row has the candidate's target epoch. -/
@[step]
theorem double_vote_scan_spec
    (candidate : attestation_rules.AttestationRecord)
    (history : Slice attestation_rules.AttestationRecord) (history_len : Usize)
    (hlen : history_len.val = history.length) :
    attestation_rules.check_attestation_loop0 candidate history history_len false false 0#usize
      ⦃ res =>
        res.1 = true ↔ ∃ stored ∈ history.v, stored.target_epoch = candidate.target_epoch ⦄ := by
  unfold attestation_rules.check_attestation_loop0
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => history.length - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (x.1 = true ↔
          ∃ stored ∈ history.v.take x.2.2.val, stored.target_epoch = candidate.target_epoch))
  · rintro ⟨stf, sr, i⟩ ⟨hi, hstf⟩
    dsimp only at hi hstf
    unfold attestation_rules.check_attestation_loop0.body
    dsimp only
    split
    · have hlt : i.val < history.length := by scalar_tac
      step as ⟨row, hrow⟩
      have htake : history.v.take (i.val + 1) = history.v.take i.val ++ [row] := by
        rw [List.take_add_one, hrow]; simp [hlt]
      split
      · step as ⟨beq⟩
        split <;>
          (step as ⟨i3, hi3⟩ <;>
            first
              | scalar_tac
              | (refine ⟨by omega, ?_, by omega⟩ <;>
                  (rw [hi3, htake]
                   first
                     | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
      · step as ⟨i3, hi3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, by omega⟩ <;>
                (rw [hi3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind))
    · have hieq : i.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hieq] at hstf
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at hstf
      exact hstf
  · simp

/-- `prev_surrounds` is true iff a stored row surrounds the candidate. `new_surrounds` is
    true iff the candidate surrounds a stored row. -/
@[step]
theorem surround_scan_spec
    (candidate : attestation_rules.AttestationRecord)
    (history : Slice attestation_rules.AttestationRecord) (history_len : Usize)
    (hlen : history_len.val = history.length) :
    attestation_rules.check_attestation_loop1 candidate history history_len false false 0#usize
      ⦃ res =>
      (res.1 = true ↔ ∃ stored ∈ history.v,
        stored.source_epoch < candidate.source_epoch
        ∧ candidate.target_epoch < stored.target_epoch)
      ∧ (res.2 = true ↔ ∃ stored ∈ history.v,
        candidate.source_epoch < stored.source_epoch
        ∧ stored.target_epoch < candidate.target_epoch) ⦄ := by
  unfold attestation_rules.check_attestation_loop1
  apply loop.spec_decr_nat
    (measure := fun (x : Bool × Bool × Usize) => history.length - x.2.2.val)
    (inv := fun (x : Bool × Bool × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (x.1 = true ↔ ∃ stored ∈ history.v.take x.2.2.val,
          stored.source_epoch < candidate.source_epoch
          ∧ candidate.target_epoch < stored.target_epoch)
      ∧ (x.2.1 = true ↔ ∃ stored ∈ history.v.take x.2.2.val,
          candidate.source_epoch < stored.source_epoch
          ∧ stored.target_epoch < candidate.target_epoch))
  · rintro ⟨prev, new, i⟩ ⟨hi, hprev, hnew⟩
    dsimp only at hi hprev hnew
    unfold attestation_rules.check_attestation_loop1.body
    dsimp only
    split
    · have hlt : i.val < history.length := by scalar_tac
      step as ⟨row, hrow⟩
      have htake : history.v.take (i.val + 1) = history.v.take i.val ++ [row] := by
        rw [List.take_add_one, hrow]; simp [hlt]
      repeat' split
      all_goals (
        step as ⟨i3, hi3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, ?_, by omega⟩ <;>
                (rw [hi3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
    · have hieq : i.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hieq] at hprev hnew
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at hprev hnew
      exact ⟨hprev, hnew⟩
  · simp

/-- The loop returns the smallest source and the smallest target in the history. -/
@[step]
theorem minima_spec
    (history : Slice attestation_rules.AttestationRecord) (history_len : Usize)
    (min_source min_target : U64) (i : Usize)
    (hlen : history_len.val = history.length) (hi : i.val ≤ history.length)
    (hmin_source_le : ∀ stored ∈ history.v.take i.val, min_source ≤ stored.source_epoch)
    (hmin_source_mem : ∃ stored ∈ history.v.take i.val, min_source = stored.source_epoch)
    (hmin_target_le : ∀ stored ∈ history.v.take i.val, min_target ≤ stored.target_epoch)
    (hmin_target_mem : ∃ stored ∈ history.v.take i.val, min_target = stored.target_epoch) :
    attestation_rules.check_attestation_loop2 history history_len min_source min_target i ⦃ res =>
      (∀ stored ∈ history.v, res.1 ≤ stored.source_epoch)
      ∧ (∃ stored ∈ history.v, res.1 = stored.source_epoch)
      ∧ (∀ stored ∈ history.v, res.2 ≤ stored.target_epoch)
      ∧ (∃ stored ∈ history.v, res.2 = stored.target_epoch) ⦄ := by
  unfold attestation_rules.check_attestation_loop2
  apply loop.spec_decr_nat
    (measure := fun (x : U64 × U64 × Usize) => history.length - x.2.2.val)
    (inv := fun (x : U64 × U64 × Usize) =>
      x.2.2.val ≤ history.length
      ∧ (∀ stored ∈ history.v.take x.2.2.val, x.1 ≤ stored.source_epoch)
      ∧ (∃ stored ∈ history.v.take x.2.2.val, x.1 = stored.source_epoch)
      ∧ (∀ stored ∈ history.v.take x.2.2.val, x.2.1 ≤ stored.target_epoch)
      ∧ (∃ stored ∈ history.v.take x.2.2.val, x.2.1 = stored.target_epoch))
  · rintro ⟨ms1, mt1, j⟩ ⟨hj, h1, h2, h3, h4⟩
    dsimp only at hj h1 h2 h3 h4
    unfold attestation_rules.check_attestation_loop2.body
    dsimp only
    split
    · have hlt : j.val < history.length := by scalar_tac
      step as ⟨row, hrow⟩
      have htake : history.v.take (j.val + 1) = history.v.take j.val ++ [row] := by
        rw [List.take_add_one, hrow]; simp [hlt]
      repeat' split
      all_goals (
        step as ⟨j3, hj3⟩ <;>
          first
            | scalar_tac
            | (refine ⟨by omega, ?_, ?_, ?_, ?_, by omega⟩ <;>
                (rw [hj3, htake]
                 first
                   | (simp_all; done) | (simp_all; tauto) | (simp_all; grind) | grind)))
    · have hjeq : j.val = history.length := by scalar_tac
      simp only [spec_ok]
      rw [hjeq] at h1 h2 h3 h4
      have hfull : history.v.take history.length = history.v := by simp [Slice.length]
      rw [hfull] at h1 h2 h3 h4
      exact ⟨h1, h2, h3, h4⟩
  · exact ⟨hi, hmin_source_le, hmin_source_mem, hmin_target_le, hmin_target_mem⟩

/-! ## Soundness of Lighthouse's `check_attestation` -/

/-- If `check_attestation` returns `Valid`, no stored row is slashable against the candidate. -/
theorem check_attestation_sound
    (history : Slice attestation_rules.AttestationRecord)
    (candidate : attestation_rules.AttestationRecord) :
    attestation_rules.check_attestation history candidate ⦃ res =>
      res = attestation_rules.Verdict.Valid →
        ∀ stored ∈ history.v, ¬ Slashable candidate stored ⦄ := by
  unfold attestation_rules.check_attestation
  split
  · simp
  · step as ⟨found, same, hfound⟩
    split
    · split <;> simp
    · step as ⟨prev, new, hprev, hnew⟩
      split
      · simp
      · split
        · simp
        · split
          · step as ⟨row, hrow⟩
            have hpos : 0 < history.v.length := by
              have : 0 < history.length := by scalar_tac
              simpa [Slice.length] using this
            have htake1 : history.v.take 1 = [row] := by
              simp [hrow, List.take_one, List.head?_eq_getElem?, hpos]
            step as ⟨min_source, min_target, hmin_source_le, hmin_source_mem, hmin_target_le,
              hmin_target_mem⟩
            case hmin_source_le => simp [htake1]
            case hmin_source_mem => simp [htake1]
            case hmin_target_le => simp [htake1]
            case hmin_target_mem => simp [htake1]
            split
            · simp
            · split
              · simp
              · intro _ stored hstored
                rintro (⟨ht, hr⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩)
                · exact absurd (hfound.mpr ⟨stored, hstored, ht.symm⟩) (by simp_all)
                · exact absurd (hnew.mpr ⟨stored, hstored, h1, h2⟩) (by simp_all)
                · exact absurd (hprev.mpr ⟨stored, hstored, h1, h2⟩) (by simp_all)
          · intro _ stored hstored
            have hlen : history.length = 0 := by scalar_tac
            have hnil : history.v = [] := by
              simpa [Slice.length, List.length_eq_zero_iff] using hlen
            simp [hnil] at hstored

end SlashingProofs
